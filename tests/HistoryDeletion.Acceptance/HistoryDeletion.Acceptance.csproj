<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>SelectionProbe.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup><Reference Include="SelectionProbe"><HintPath>$(RuntimePayloadDll)</HintPath></Reference></ItemGroup>
  <Target Name="RequirePublishedRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RuntimePayloadDll)' == '' or !Exists('$(RuntimePayloadDll)')" Text="Pass RuntimePayloadDll pointing to the verified published SelectionProbe.dll." />
  </Target>
</Project>
