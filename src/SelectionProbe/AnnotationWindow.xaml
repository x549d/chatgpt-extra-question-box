<Window x:Class="ContextNotes.SelectionProbe.AnnotationWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Notes" Width="324" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="True"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34363E"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#4E525E"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" Margin="4" CornerRadius="11" Background="#232428"
            BorderBrush="#454852" BorderThickness="1" Padding="12,10,12,11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Draggable Header -->
            <Grid x:Name="HeaderBar" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Context Notes" Foreground="#F3F4F6" FontSize="12.5"
                               FontFamily="Microsoft YaHei UI, Segoe UI" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModelBadge" Text="" Foreground="#9CA3AF" FontSize="11"
                               FontFamily="Microsoft YaHei UI, Segoe UI" Visibility="Collapsed"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock x:Name="CollapsedBadge" Text=" · 已折叠" Foreground="#9CA3AF" FontSize="11.5"
                               FontFamily="Microsoft YaHei UI, Segoe UI" Visibility="Collapsed"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CollapseButton" Grid.Column="1" Content="—" Width="22" Height="22" Margin="4,0,2,0"
                        Cursor="Hand" Focusable="False" IsTabStop="False" ToolTip="折叠旁注"
                        Click="OnToggleExpand" Foreground="#D1D5DB" FontSize="11" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="BtnBg" CornerRadius="5" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="#363840"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="2" Content="×" Width="22" Height="22"
                        Cursor="Hand" Focusable="False" IsTabStop="False" ToolTip="关闭旁注"
                        Click="OnCloseClick" Foreground="#D1D5DB" FontSize="14" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="BtnBg" CornerRadius="5" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="#4B282C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Collapsible Body -->
            <StackPanel x:Name="BodyPanel" Margin="0,8,0,0">
                <!-- Quote Header -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="已引用内容" Foreground="#9CA3AF" FontSize="11.5"
                               FontFamily="Microsoft YaHei UI, Segoe UI" VerticalAlignment="Center"/>
                    <Button x:Name="QuoteToggleButton" Grid.Column="1" Content="收起" Cursor="Hand"
                            Focusable="False" IsTabStop="False" Click="OnToggleQuote"
                            Foreground="#9CA3AF" FontSize="11" Padding="4,1"
                            FontFamily="Microsoft YaHei UI, Segoe UI">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="QuoteToggleBg" CornerRadius="4" Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="QuoteToggleBg" Property="Background" Value="#32343C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Quoted Text Box -->
                <Border x:Name="QuoteBorder" CornerRadius="7" Background="#18191C"
                        BorderBrush="#34363E" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                    <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <TextBlock x:Name="QuoteTextBlock" Foreground="#E5E7EB" FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Conversation Messages Stream Area -->
                <Border x:Name="ConversationBorder" CornerRadius="8" Background="#1A1B1F"
                        BorderBrush="#32353E" BorderThickness="1" Padding="8,6" Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <ScrollViewer x:Name="ConversationScrollViewer" MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="MessagesPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- Question Prompt -->
                <TextBlock x:Name="PromptLabel" Text="关于这段内容，你想问什么？" Foreground="#D1D5DB" FontSize="12"
                           FontFamily="Microsoft YaHei UI, Segoe UI" Margin="0,0,0,5"/>

                <!-- Input Area -->
                <Border x:Name="InputContainer" CornerRadius="8" Background="#18191C"
                        BorderBrush="#4E525E" BorderThickness="1" Padding="8,6,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBox x:Name="InputBox" Background="Transparent" Foreground="#F3F4F6"
                                     CaretBrush="#F3F4F6" SelectionBrush="#3B82F6" BorderThickness="0"
                                     FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
                                     TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="68"
                                     VerticalScrollBarVisibility="Auto"
                                     InputMethod.IsInputMethodEnabled="True"
                                     Focusable="True" IsTabStop="True" Padding="0,1,4,1"/>
                            <TextBlock x:Name="PlaceholderText" Text="输入问题……" Foreground="#6B7280"
                                       FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
                                       IsHitTestVisible="False" Margin="2,1,0,1"/>
                        </Grid>
                        <Button x:Name="StopButton" Grid.Column="1" Content="停止" Height="24" Padding="8,0"
                                Margin="4,0,0,0" Cursor="Hand" Focusable="False" IsTabStop="False"
                                Visibility="Collapsed" Click="OnStopClick" ToolTip="停止当前旁注生成"
                                Foreground="#FFFFFF" FontSize="11.5" FontFamily="Microsoft YaHei UI, Segoe UI">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="StopBg" CornerRadius="6" Background="#B91C1C"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StopBg" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="StopBg" Property="Background" Value="#991B1B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SendButton" Grid.Column="2" Content="➤" Width="28" Height="24"
                                Margin="4,0,0,0" Cursor="Hand" Focusable="False" IsTabStop="False"
                                Click="OnSendClick" ToolTip="发送问题（Enter 发送，Shift+Enter 换行）"
                                Foreground="#FFFFFF" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="SendBg" CornerRadius="6" Background="#10A37F">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SendBg" Property="Background" Value="#0E8F6F"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="SendBg" Property="Background" Value="#0B755B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Status & Error Notice -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="历史" Click="OnHistoryClick" ToolTip="旁注历史（Ctrl+Alt+H）" Padding="6,2"/>
                    <Button Content="模型与用量" Click="OnModelClick" Margin="6,0,0,0" Padding="6,2"/>
                    <Button x:Name="ThreadRecoveryButton" Content="新 Thread 恢复" Click="OnThreadRecoveryClick" Visibility="Collapsed" Margin="6,0,0,0" Padding="6,2"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#9CA3AF" FontSize="11"
                           FontFamily="Microsoft YaHei UI, Segoe UI" Margin="2,5,2,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
