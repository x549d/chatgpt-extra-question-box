<Window x:Class="ContextNotes.SelectionProbe.QuestionOverlay" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Notes" Width="114" Height="28"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False"
        ShowInTaskbar="False" Focusable="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <Button Content="向 ChatGPT 提问" Click="OnClick" Cursor="Hand" Focusable="False" IsTabStop="False"
            Padding="8,0" Foreground="#F5F6F8" FontSize="12" FontFamily="Microsoft YaHei UI"
            FontWeight="SemiBold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
                <Border x:Name="Surface" CornerRadius="7" Background="#25282C" BorderBrush="#60656D" BorderThickness="1"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="False"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#363A40"/>
                        <Setter TargetName="Surface" Property="BorderBrush" Value="#8C94A0"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#1C1E22"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
